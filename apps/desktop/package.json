{
  "name": "@sparkle/desktop",
  "version": "0.142.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-mcp-server.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/copy-mcp-server.mjs",
    "preview": "vite preview",
    "screenshot": "node scripts/screenshot.mjs",
    "measure:webgl": "node scripts/measure-webgl-context-limit.mjs",
    "measure:webgl-garbage": "node scripts/measure-webgl-garbage-frames.mjs",
    "measure:webgl-fleet": "node scripts/measure-webgl-fleet-jank.mjs",
    "visual:capture": "node scripts/visual/capture.mjs",
    "visual:compare": "node scripts/visual/compare.mjs",
    "visual:verify-stable": "node scripts/visual/verify-stable.mjs",
    "visual:recap-narrow": "node scripts/visual/recap-narrow-probe.mjs",
    "visual:blocked-row-narrow": "node scripts/visual/blocked-row-narrow-probe.mjs",
    "visual:row-narrow": "node scripts/visual/row-narrow-probe.mjs",
    "visual:tab-crowded": "node scripts/visual/tab-crowded-probe.mjs",
    "visual:tab-click": "node scripts/visual/tab-click-probe.mjs",
    "visual:task-focus": "node scripts/visual/task-focus-probe.mjs",
    "visual:tab-seam": "node scripts/visual/tab-seam-probe.mjs",
    "visual:tab-column": "node scripts/visual/tab-column-probe.mjs",
    "visual:quote-surface": "node scripts/visual/quote-surface-probe.mjs",
    "visual:autosend-pause": "node scripts/visual/autosend-pause-probe.mjs",
    "visual:prose-row-wrap": "node scripts/visual/prose-row-wrap-probe.mjs",
    "visual:reply-quote": "node scripts/visual/reply-quote-shot.mjs",
    "visual": "pnpm visual:capture && pnpm visual:compare",
    "lint": "eslint src --max-warnings 12",
    "typecheck": "tsc --noEmit",
    "test": "bash ../../scripts/vitest-run.sh",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "tauri:build:fresh": "cargo clean -p sparkle --manifest-path src-tauri/Cargo.toml && tauri build",
    "visual:concierge-header": "node scripts/visual/concierge-header-probe.mjs",
    "visual:scrubber": "node scripts/visual/thread-scrubber-probe.mjs",
    "visual:notice-attribution": "node scripts/visual/notice-attribution-probe.mjs",
    "visual:credit-pill-mic": "node scripts/visual/credit-pill-mic-probe.mjs"
  },
  "dependencies": {
    "@sparkle/core": "workspace:*",
    "@sparkle/ui": "workspace:*",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "posthog-js": "^1.393.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "2.1.9",
    "@xterm/headless": "^6.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
